# =============================================================================
# Home Dashboard — environment variables (Dokploy / Docker / local)
# Copy to .env and fill in. Existing process env always wins over .env file.
# =============================================================================

# --- App ---
ASPNETCORE_ENVIRONMENT=Production
# Optional: path to env file inside container (default: /app/.env or cwd/.env)
# ENV_FILE=/app/.env

# Host port mapping for docker compose only
PORT=8080

# --- Admin (seeded on first start if user does not exist) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# --- JWT (use a long random secret in production, 32+ chars) ---
JWT_KEY=home-dashboard-change-this-secret-key-32chars
JWT_ISSUER=Home.Api
JWT_AUDIENCE=Home.Web
JWT_EXPIRE_HOURS=72

# --- Database (pick ONE style) ---

# A) Full connection string
# CONNECTION_STRING=Host=postgres;Port=5432;Database=home_dashboard;Username=home;Password=secret

# B) Separate fields (convenient in Dokploy)
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_NAME=home_dashboard
DATABASE_USER=home
DATABASE_PASSWORD=home

# Aliases also accepted: POSTGRES_HOST, POSTGRES_PORT, POSTGRES_DB, POSTGRES_USER, POSTGRES_PASSWORD
# ASP.NET style also works: ConnectionStrings__Default=Host=...;Port=5432;...

# --- Uploads (path inside container) ---
UPLOADS_PATH=/app/uploads

# --- Postgres service (docker compose only; not read by the app) ---
POSTGRES_DB=home_dashboard
POSTGRES_USER=home
POSTGRES_PASSWORD=home
